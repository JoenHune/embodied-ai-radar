{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "conflict_id", "work_id", "version", "detected_at", "reviewer_kind", "issue_types", "summary_zh", "limitations_zh", "metadata_sources", "reading_sources", "status", "resolution"],
  "properties": {
    "schema_version": {"const": "1"},
    "conflict_id": {"type": "string", "pattern": "^source-conflict:[a-f0-9]{24}$"},
    "work_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "detected_at": {"type": "string", "pattern": "Z$"},
    "reviewer_kind": {"enum": ["AI", "human"]},
    "issue_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["abstract_body_divergence", "version_date_disagreement", "source_identity_disagreement"]}},
    "summary_zh": {"type": "string", "minLength": 1, "maxLength": 1500},
    "limitations_zh": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "metadata_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["snapshot_id", "content_digest"], "properties": {"snapshot_id": {"type": "string"}, "content_digest": {"$ref": "#/$defs/hash"}}}},
    "reading_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["reading_id", "reading_digest"], "properties": {"reading_id": {"type": "string"}, "reading_digest": {"$ref": "#/$defs/hash"}}}},
    "status": {"enum": ["open", "resolved"]},
    "resolution": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["reviewed_at", "reviewer_kind", "note_zh", "source_record_ids", "reading_ids"], "properties": {"reviewed_at": {"type": "string", "pattern": "Z$"}, "reviewer_kind": {"enum": ["AI", "human"]}, "note_zh": {"type": "string", "minLength": 1, "maxLength": 1500}, "source_record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "reading_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}]}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
