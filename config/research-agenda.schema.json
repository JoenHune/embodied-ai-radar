{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embodied AI Radar Research Question Layer",
  "type": "object",
  "required": ["version", "updated", "source", "design", "questions", "omitted_directions"],
  "properties": {
    "version": {"type": "string"},
    "updated": {"type": "string", "format": "date"},
    "source": {
      "type": "object",
      "required": ["title", "visibility", "note"]
    },
    "questions": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "required": [
          "id", "priority", "title", "assessment", "role", "claim",
          "mapped_topics", "query_terms", "metrics", "falsifier", "evidence"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^Q(?:[0-9]|10)$"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "assessment": {"enum": ["A", "B", "C", "D"]},
          "mapped_topics": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "query_terms": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 2}
          },
          "metrics": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string"}
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["title", "url", "type", "note"]
            }
          }
        }
      }
    },
    "omitted_directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "mapped_topics", "why", "radar_action", "evidence"]
      }
    }
  }
}
