{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "People source-review staging (not the JSONL authority)",
  "type": "object",
  "required": ["schema_version", "review_id", "people"],
  "properties": {
    "schema_version": {"const": "1"},
    "review_id": {"type": "string", "minLength": 1},
    "people": {"type": "array", "items": {"$ref": "#/$defs/person"}}
  },
  "$defs": {
    "utc": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+Z$"},
    "url": {"type": "string", "pattern": "^https?://[^\\s]+$"},
    "evidence": {
      "type": "object",
      "required": ["kind", "url", "observed_at", "statement"],
      "properties": {
        "kind": {"enum": ["official_publications", "official_project", "orcid"]},
        "url": {"$ref": "#/$defs/url"},
        "work_url": {"$ref": "#/$defs/url"},
        "observed_at": {"$ref": "#/$defs/utc"},
        "statement": {"type": "string", "minLength": 1},
        "excerpt": {"type": ["string", "null"]}
      }
    },
    "authorship_role": {
      "type": "object",
      "required": ["role", "scope", "source_url", "work_url", "observed_at", "statement"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$"},
        "label": {"type": "string", "minLength": 1},
        "scope": {"enum": ["project", "paper"]},
        "source_url": {"$ref": "#/$defs/url"}, "work_url": {"$ref": "#/$defs/url"},
        "observed_at": {"$ref": "#/$defs/utc"}, "statement": {"type": "string", "minLength": 1},
        "excerpt": {"type": ["string", "null"]}
      }
    },
    "verification_audit": {
      "type": "object", "required": ["batch_id", "result", "checked_at", "reason", "checked_sources"],
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["verified", "unresolved"]},
        "checked_at": {"$ref": "#/$defs/utc"},
        "reason": {"type": "string", "minLength": 1},
        "checked_sources": {"type": "array", "items": {"$ref": "#/$defs/url"}}
      }
    },
    "person": {
      "type": "object",
      "required": ["person_id", "slug", "name", "identity_status", "official_profiles", "authorships"],
      "properties": {
        "person_id": {"type": "string", "pattern": "^person:[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "name_zh": {"type": ["string", "null"]},
        "identity_status": {"enum": ["profile_verified", "candidate"]},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "official_profiles": {
          "type": "array",
          "items": {"type": "object", "required": ["url", "label", "observed_at"], "properties": {
            "url": {"$ref": "#/$defs/url"}, "label": {"type": "string", "minLength": 1}, "observed_at": {"$ref": "#/$defs/utc"}
          }}
        },
        "official_roles": {"type": "array", "items": {"type": "object", "required": ["organization_name", "title", "source_url", "observed_at"], "properties": {
          "organization_id": {"type": ["string", "null"]}, "organization_name": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
          "valid_from": {"type": ["string", "null"]}, "valid_to": {"type": ["string", "null"]}, "source_url": {"$ref": "#/$defs/url"}, "observed_at": {"$ref": "#/$defs/utc"}
        }}},
        "authorships": {"type": "array", "items": {"type": "object", "required": ["work_id", "status"], "properties": {
          "work_id": {"type": "string", "minLength": 1}, "status": {"enum": ["verified", "candidate"]}, "matched_author_name": {"type": ["string", "null"]}, "verification_audit": {"$ref": "#/$defs/verification_audit"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "roles": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/authorship_role"}}]}
        }, "allOf": [{"if": {"properties": {"status": {"const": "verified"}}}, "then": {"required": ["evidence"], "properties": {"evidence": {"minItems": 1}}}}]}},
        "influence_evidence": {"type": "array", "items": {"type": "object", "required": ["dimension", "statement", "source_url", "work_id", "work_url", "observed_at", "as_of", "review_status"], "properties": {
          "dimension": {"enum": ["citation_count", "independent_adoption", "independent_replication"]},
          "statement": {"type": "string", "minLength": 1}, "source_url": {"$ref": "#/$defs/url"}, "observed_at": {"$ref": "#/$defs/utc"},
          "work_id": {"type": "string", "minLength": 1}, "work_url": {"$ref": "#/$defs/url"},
          "as_of": {"type": "string", "format": "date"}, "review_status": {"enum": ["verified", "draft"]},
          "provider": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 0},
          "adopter_name": {"type": "string", "minLength": 1}, "independent_team": {"type": "boolean"},
          "independence_statement": {"type": "string", "minLength": 1}, "independence_source_url": {"$ref": "#/$defs/url"}
        }}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
