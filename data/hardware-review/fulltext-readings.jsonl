-14T07:12:51Z","publisher_fulltext_or_media_completeness_verified":false,"range_basis":"already_read_article_with_equivalent_math_and_table_representations_reconciled_to_canonical_text","range_units":"python_unicode_characters_zero_based_half_open","raw_sha256":"ac99c28880807aaae62270ea6dce834a1ec84f9512759938c0ede851f681dd57","read_completed_at":"2026-09-14T08:34:00Z","read_ranges":[{"end":60342,"start":0}],"reader_kind":"AI","reading_id":"fulltext-reading:a045071cb9461901060fad01","reading_status":"completed","schema_version":"1","source_availability_status":"full_text_available","source_url":"https://arxiv.org/html/2608.30242v1","supplementary_materials_inspected":false,"supplementary_scope_note":"external_media_only; embedded_appendix_text_is_within_article_scope","tables_exhaustive":false,"text_scope":"complete_available_article_text","transport_verification":"legacy_unrecorded","understanding_verified":false,"verification_scope":"source_identity_hash_ranges_and_locators_only","version":"v1","work_id":"arxiv:2608.30242"}
