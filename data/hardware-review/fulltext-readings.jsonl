1a2ed5cf887271c078bf35fbfa69d18a7f19622a3e3b59aa42eb2"},"source_locator":"S3.SS3","text_zh":"正文称四步因果蒸馏支持12 FPS的视频预测；这是该段报告的视频生成吞吐。"},{"locator_text_sha256":{"A2.T5":"34dd5fa86c5da6f83f205c581229d0e6a9dbe5d02c6225aa40bdabc75bc01cf4"},"source_locator":"A2.T5","text_zh":"位姿提取后处理消融中，Gen6D基线5/10，加入运动遮罩、离群剔除和时序滤波后达到10/10。"}],"human_reviewed":false,"images_inspected":false,"limitations_zh":[{"locator_text_sha256":{"S4.SS2":"dcc56537c9596571a156980993c7911bfe3d8c84de067b13a4b0dd12c475f62e"},"source_locator":"S4.SS2","text_zh":"RLBench表1中的Image-BC、UniPi、4DWM结果直接引自4DWM论文，不是本文统一重跑的全部基线。"},{"locator_text_sha256":{"S5.T3":"4a33da82c163f0c31d00311de638dbe0dbd66a00eb5d7e34ab7c2c54d0f22e5d"},"source_locator":"S5.T3","text_zh":"表3的open/cup单元为破折号，7/10位于open/jar；该表不能支持开杯70%的说法。"},{"locator_text_sha256":{"A10":"efdbd8c6357fe907f8156ccdb209d7dad14c95d0bba1f249724547a44cb26a1d"},"source_locator":"A10","text_zh":"附录J文字称十二个二元子标准，但同一附录表格列出十三项、总分十三，存在计数不一致。"},{"locator_text_sha256":{"A8.T9":"f6025f31f42305f4ec44446f442ffdf2983f050b2686d78958bdc68d0595be88"},"source_locator":"A8.T9","text_zh":"A100效率表中本法为16秒生成32帧即2 FPS；Wan使用720p而其他模型主要480p，比较条件不完全一致。"},{"locator_text_sha256":{"A8.SS5":"3c1437bbe789059ce8f3ff8ad01b357cf0d6da2da4e08c82b5f79c2d0535e7d8"},"source_locator":"A8.SS5","text_zh":"附录H.5明确把测速称为未使用蒸馏或少步优化，并报告每原语约31秒；不能将此完整流程直接描述为实时控制。"},{"locator_text_sha256":{"A2.SS2":"447f1deec48c9cd99a8694fed1c0ce0e202572b664af6dfe95c68582f30d889e"},"source_locator":"A2.SS2","text_zh":"垂直相机视角下位姿提取仅7/10成功，远距离或不足15像素的位移会失败。"}],"math_source_note_zh":"原阅读已完整覆盖公式alttext/TeX及逐行列科研表；本次核对本篇172个math节点，所读TeX与canonical保留的TeX表示一致，规范串另保留MathML/TeX重复及原空白。规范范围只是已读同一原文的统一字符坐标，不新增阅读内容；未查看图片公式、视觉渲染或外部补充材料。","observed_at":"2026-09-14T07:14:00Z","publisher_fulltext_or_media_completeness_verified":false,"range_basis":"already_read_article_with_equivalent_math_and_table_representations_reconciled_to_canonical_text","range_units":"python_unicode_characters_zero_based_half_open","raw_sha256":"06f4f6e555fa4c4b873f187273a35c8b