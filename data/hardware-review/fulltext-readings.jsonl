},{"locator_text_sha256":{"S4.T3":"d2e2ee5f26dfc52b62d0f1b7050ce74a970190e43365faf20303067ac3f60f36"},"source_locator":"S4.T3","text_zh":"表3部分Avg不等于三个误差的算术均值，例如Qwen3B域外三项计算约185.76，而表中写250.67；未说明其他权重，不能自行修正。"},{"locator_text_sha256":{"S5":"f5b480b9a1620e55303899b2a841c83e74fa48aa49077b6d431e4ef9f1f04fda"},"source_locator":"S5","text_zh":"论文明确尚未在双臂或四足等其他类型平台开发、验证。"},{"locator_text_sha256":{"S4.SS4":"c439e250d896b21a95163f2977fba0f386aa96beba55b497b7beccf3c1143e34"},"source_locator":"S4.SS4","text_zh":"此真实实验设置没有明确列出机械臂、相机和计算设备型号，不能从未查看的图片补猜硬件。"},{"locator_text_sha256":{"S3.SS4":"95a52e887cd4686c8f6a00b48cabae495f4cfe865a65a95110969009e9f8a2e5"},"source_locator":"S3.SS4","text_zh":"轨迹距离正文使用ALAF名称，公式3却写ALHF下标，复现前应确认对应实现。"}],"math_source_note_zh":"原阅读已完整覆盖公式alttext/TeX及逐行列科研表；本次核对本篇54个math节点，所读TeX与canonical保留的TeX表示一致，规范串另保留MathML/TeX重复及原空白。规范范围只是已读同一原文的统一字符坐标，不新增阅读内容；未查看图片公式、视觉渲染或外部补充材料。","observed_at":"2026-09-14T07:14:44Z","publisher_fulltext_or_media_completeness_verified":false,"range_basis":"already_read_article_with_equivalent_math_and_table_representations_reconciled_to_canonical_text","range_units":"python_unicode_characters_zero_based_half_open","raw_sha256":"2e886537822170ab0f72f712a68c5430577f1cd4e9caea178f58cd384076035b","read_completed_at":"2026-09-14T08:44:39.850Z","read_ranges":[{"end":41906,"start":0}],"reader_kind":"AI","reading_id":"fulltext-reading:57481cb4d009d0e8cc2af297","reading_status":"completed","schema_version":"1","source_availability_status":"full_text_available","source_url":"https://arxiv.org/html/2510.01623v1","supplementary_materials_inspected":false,"supplementary_scope_note":"external_media_only; embedded_appendix_text_is_within_article_scope","tables_exhaustive":false,"text_scope":"complete_available_article_text","transport_verification":"legacy_unrecorded","understanding_verified":false,"verification_scope":"source_identity_hash_ranges_and_locators_only","version":"v1","work_id":"arxiv:2510.01623"}
