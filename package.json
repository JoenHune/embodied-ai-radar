{
  "name": "embodied-ai-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "具身智能研究雷达：2025.07–2026.06 月度趋势与证据库",
  "scripts": {
    "collect": "python3 scripts/collect_semantic_scholar.py",
    "collect:arxiv": "python3 scripts/collect_arxiv.py",
    "collect:arxiv-v2": "python3 scripts/collect_arxiv_v2.py",
    "collect:publications": "python3 scripts/collect_publications.py --scope core",
    "collect:official": "python3 scripts/collect_official_containers.py",
    "collect:official-programs": "python3 scripts/collect_official_programs.py",
    "import:github": "python3 scripts/import_github_audit.py",
    "refresh:github": "python3 scripts/refresh_github_metadata.py",
    "seed:groups": "python3 scripts/build_organizations_seed.py",
    "collect:groups": "python3 scripts/collect_group_sources.py",
    "resolve:groups": "python3 scripts/resolve_organizations.py",
    "merge:v2": "python3 scripts/merge_corpora_v2.py",
    "prepare:data": "node scripts/prepare-data.mjs",
    "generate": "node scripts/generate-site.mjs && node scripts/generate-v2-pages.mjs && node scripts/generate-research-agenda.mjs && node scripts/generate-research-groups.mjs",
    "audit": "node scripts/audit-data.mjs",
    "audit:v2": "node scripts/audit-v2.mjs",
    "audit:questions": "node scripts/audit-research-agenda.mjs",
    "audit:groups": "node scripts/audit-organizations.mjs",
    "publish:groups:feishu": "python3 scripts/publish_group_weekly_to_feishu.py",
    "merge": "bash scripts/merge.sh",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run generate && npm run merge && npm run typecheck && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "npm run generate && npm run merge && npm run audit && npm run audit:v2 && npm run audit:questions && npm run audit:groups && npm run publish:groups:feishu -- --dry-run && npm run typecheck && vitepress build docs"
  },
  "devDependencies": {
    "debug": "^4.4.1",
    "echarts": "^6.1.0",
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "11.16.0",
    "typescript": "^5.9.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "vue-tsc": "^3.3.9"
  }
}
